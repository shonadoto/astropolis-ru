#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ENV_FILE="$ROOT_DIR/.server.env"
if [[ -f "$ENV_FILE" ]]; then
  # The Minecraft JVM and the local AI bridge need the configured values too.
  set -a
  source "$ENV_FILE"
  set +a
fi

SERVER_DIR="${ASTROPOLIS_SERVER_DIR:-$ROOT_DIR/server}"
MIN_RAM="${MIN_RAM:-4G}"
MAX_RAM="${MAX_RAM:-10G}"
STOP_TIMEOUT="${STOP_TIMEOUT:-120}"
CONSOLE_LOG="$SERVER_DIR/console.log"
COMMAND_FILE="$SERVER_DIR/.console-input"
PID_FILE="$SERVER_DIR/.server.pid"
BACKUP_DIR="${BACKUP_DIR:-$ROOT_DIR/backups}"
AI_BRIDGE_SCRIPT="$ROOT_DIR/tools/astropolis_ai_bridge.py"
AI_KUBEJS_SOURCE="$ROOT_DIR/server-assets/kubejs/server_scripts/astropolis_ai.js"
AI_KUBEJS_TARGET="$SERVER_DIR/kubejs/server_scripts/astropolis_ai.js"
AI_KUBEJS_CONFIG_SOURCE="$ROOT_DIR/server-assets/kubejs/config/common.properties"
AI_KUBEJS_CONFIG_TARGET="$SERVER_DIR/kubejs/config/common.properties"
AI_PID_FILE="$SERVER_DIR/.ai-bridge.pid"
AI_LOG="$SERVER_DIR/ai-bridge.log"
AI_BRIDGE_PORT="${AI_BRIDGE_PORT:-8765}"

say() { printf '[astropolis] %s\n' "$*"; }
die() { say "ERROR: $*" >&2; exit 1; }

read_pid() {
  [[ -s "$PID_FILE" ]] || return 1
  local pid
  read -r pid < "$PID_FILE"
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  printf '%s\n' "$pid"
}

is_running() {
  local pid
  pid="$(read_pid)" || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  [[ "$(readlink -f "/proc/$pid/cwd" 2>/dev/null || true)" == "$(readlink -f "$SERVER_DIR")" ]]
}

read_ai_pid() {
  [[ -s "$AI_PID_FILE" ]] || return 1
  local pid
  read -r pid < "$AI_PID_FILE"
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  printf '%s\n' "$pid"
}

ai_is_running() {
  local pid
  pid="$(read_ai_pid)" || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  [[ "$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)" == *"astropolis_ai_bridge.py"* ]]
}

start_ai_bridge() {
  [[ -f "$AI_BRIDGE_SCRIPT" ]] || {
    say "WARNING: AI bridge script is missing; /ai will be unavailable"
    return 0
  }
  if ai_is_running; then
    return 0
  fi
  rm -f "$AI_PID_FILE"
  touch "$AI_LOG"
  (
    cd "$ROOT_DIR"
    setsid python3 -u "$AI_BRIDGE_SCRIPT" >> "$AI_LOG" 2>&1 &
    printf '%s\n' "$!" > "$AI_PID_FILE"
  )
  for _ in {1..50}; do
    if ai_is_running && curl --noproxy '*' -fsS --max-time 1 \
      "http://127.0.0.1:$AI_BRIDGE_PORT/health" >/dev/null 2>&1; then
      break
    fi
    sleep 0.1
  done
  if ai_is_running && curl --noproxy '*' -fsS --max-time 1 \
    "http://127.0.0.1:$AI_BRIDGE_PORT/health" >/dev/null 2>&1; then
    say "AI bridge started (PID $(read_ai_pid), loopback port $AI_BRIDGE_PORT)"
  else
    rm -f "$AI_PID_FILE"
    say "WARNING: AI bridge failed to start; inspect $AI_LOG"
  fi
}

deploy_ai_integration() {
  [[ -f "$AI_KUBEJS_SOURCE" ]] || die "AI KubeJS script is missing: $AI_KUBEJS_SOURCE"
  mkdir -p "$(dirname "$AI_KUBEJS_TARGET")"
  install -m 0644 "$AI_KUBEJS_SOURCE" "$AI_KUBEJS_TARGET"
  install -m 0644 "$AI_KUBEJS_CONFIG_SOURCE" "$AI_KUBEJS_CONFIG_TARGET"
  say "AI KubeJS command deployed"
}

stop_ai_bridge() {
  if ! ai_is_running; then
    rm -f "$AI_PID_FILE"
    return 0
  fi
  local pid
  pid="$(read_ai_pid)"
  kill "$pid" 2>/dev/null || true
  for _ in {1..30}; do
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.1
  done
  kill -KILL "$pid" 2>/dev/null || true
  rm -f "$AI_PID_FILE"
  say "AI bridge stopped"
}

java_bin() {
  if [[ -n "${JAVA_BIN:-}" && -x "$JAVA_BIN" ]]; then
    printf '%s\n' "$JAVA_BIN"
  elif [[ -s "$SERVER_DIR/.astropolis-java" ]] && [[ -x "$(cat "$SERVER_DIR/.astropolis-java")" ]]; then
    cat "$SERVER_DIR/.astropolis-java"
  else
    local candidate
    candidate="$(find "$ROOT_DIR/runtime" -path '*/bin/java' -type f -perm -u+x 2>/dev/null | sort -r | head -n 1)"
    [[ -n "$candidate" ]] || die "Java 17 not found; run: ./serverctl install"
    printf '%s\n' "$candidate"
  fi
}

forge_args() {
  [[ -s "$SERVER_DIR/.astropolis-forge" ]] || die "Forge is not installed; run: ./serverctl install"
  local version
  read -r version < "$SERVER_DIR/.astropolis-forge"
  local args="$SERVER_DIR/libraries/net/minecraftforge/forge/$version/unix_args.txt"
  [[ -f "$args" ]] || die "Forge arguments not found: $args"
  printf '%s\n' "$args"
}

sync_resource_pack_hash() {
  local properties="$SERVER_DIR/server.properties"
  [[ -f "$properties" ]] || return 0
  command -v curl >/dev/null 2>&1 || {
    say "WARNING: curl not found; resource pack hash was not refreshed"
    return 0
  }

  local url base_url fetch_url digest current versioned_url escaped_url
  url="$(sed -n 's/^resource-pack=//p' "$properties" | head -n 1)"
  url="${url//\\:/:}"
  url="${url//\\=/=}"
  [[ -n "$url" ]] || return 0

  # The resource-pack-latest release asset is replaced in place. Give both the
  # refresh request and the URL sent to Minecraft a unique query string so the
  # client and GitHub's CDN cannot reuse an older archive for a newer SHA-1.
  base_url="${url%%\?sha1=*}"
  fetch_url="${base_url}?refresh=$(date +%s)-$$"

  if ! digest="$(curl -fsSL "$fetch_url" | sha1sum | awk '{print $1}')"; then
    say "WARNING: could not download the resource pack; keeping the existing hash"
    return 0
  fi
  [[ "$digest" =~ ^[0-9a-f]{40}$ ]] || {
    say "WARNING: invalid resource pack hash; keeping the existing hash"
    return 0
  }

  current="$(sed -n 's/^resource-pack-sha1=//p' "$properties" | head -n 1)"
  versioned_url="${base_url}?sha1=${digest}"
  escaped_url="${versioned_url//:/\\:}"
  if [[ "$url" != "$versioned_url" ]]; then
    sed -i "s|^resource-pack=.*|resource-pack=$escaped_url|" "$properties"
    say "resource pack URL cache key updated: $digest"
  fi
  if [[ "$current" != "$digest" ]]; then
    sed -i "s/^resource-pack-sha1=.*/resource-pack-sha1=$digest/" "$properties"
    say "resource pack hash updated: $digest"
  fi
}

send_command() {
  is_running || die "server is not running"
  [[ $# -gt 0 ]] || die "console command is empty"
  printf '%s\n' "$*" >> "$COMMAND_FILE"
}

cmd_install() {
  is_running && die "stop the server before installing or deploying"
  ASTROPOLIS_SERVER_DIR="$SERVER_DIR" python3 "$ROOT_DIR/tools/install_server.py"
}

cmd_start() {
  if is_running; then
    say "already running (PID $(read_pid))"
    return 0
  fi
  rm -f "$PID_FILE"
  [[ -f "$SERVER_DIR/eula.txt" ]] || die "server is not installed; run: ./serverctl install"
  deploy_ai_integration
  start_ai_bridge
  sync_resource_pack_hash
  local java args
  java="$(java_bin)"
  args="$(forge_args)"
  : > "$COMMAND_FILE"
  touch "$CONSOLE_LOG"
  say "starting with Java 17, RAM $MIN_RAM..$MAX_RAM"
  (
    cd "$SERVER_DIR"
    setsid bash -c '
      echo "$$" > "$1"
      exec "$2" "-Xms$3" "-Xmx$4" \
        -XX:+UseG1GC -XX:+ParallelRefProcEnabled -XX:MaxGCPauseMillis=200 \
        -XX:+UnlockExperimentalVMOptions -XX:+DisableExplicitGC -XX:+AlwaysPreTouch \
        "@$5" nogui < <(tail -n 0 -F "$6") >> "$7" 2>&1
    ' bash "$PID_FILE" "$java" "$MIN_RAM" "$MAX_RAM" "$args" "$COMMAND_FILE" "$CONSOLE_LOG" &
  )
  for _ in {1..50}; do
    is_running && break
    sleep 0.1
  done
  is_running || die "server process did not start; inspect $CONSOLE_LOG"
  say "started (PID $(read_pid)); use './serverctl logs' to follow startup"
}

cmd_stop() {
  if ! is_running; then
    rm -f "$PID_FILE"
    stop_ai_bridge
    say "already stopped"
    return 0
  fi
  local pid waited=0
  pid="$(read_pid)"
  say "requesting graceful shutdown (PID $pid)"
  printf 'stop\n' >> "$COMMAND_FILE"
  while kill -0 "$pid" 2>/dev/null && (( waited < STOP_TIMEOUT )); do
    sleep 1
    ((waited+=1))
  done
  if kill -0 "$pid" 2>/dev/null; then
    say "console shutdown timed out; sending SIGTERM"
    kill "$pid" 2>/dev/null || true
    for _ in {1..20}; do
      kill -0 "$pid" 2>/dev/null || break
      sleep 1
    done
  fi
  if kill -0 "$pid" 2>/dev/null; then
    say "SIGTERM timed out; sending SIGKILL"
    kill -KILL "$pid" 2>/dev/null || true
  fi
  rm -f "$PID_FILE"
  stop_ai_bridge
  say "stopped"
}

cmd_status() {
  if is_running; then
    local pid
    pid="$(read_pid)"
    say "RUNNING (PID $pid, port ${SERVER_PORT:-25565})"
    ps -p "$pid" -o pid=,etime=,%cpu=,%mem=,rss=,cmd=
  else
    say "STOPPED"
  fi
  if ai_is_running; then
    say "AI BRIDGE RUNNING (PID $(read_ai_pid), port $AI_BRIDGE_PORT)"
  else
    say "AI BRIDGE STOPPED"
  fi
  is_running
}

cmd_ai_status() {
  if ! ai_is_running; then
    say "AI bridge is stopped"
    return 1
  fi
  curl --noproxy '*' -fsS --max-time 3 "http://127.0.0.1:$AI_BRIDGE_PORT/health"
  printf '\n'
}

cmd_ai_deploy() {
  deploy_ai_integration
  stop_ai_bridge
  start_ai_bridge
  if is_running; then
    say "Minecraft is already running; /ai will be registered after its next restart"
  fi
}

cmd_ai_configure() {
  [[ -t 0 ]] || die "ai-configure must be run from an interactive terminal"
  local key template tmp
  read -r -s -p "OpenAI API key: " key
  printf '\n'
  [[ "$key" == sk-* ]] || die "the key must start with sk-"
  template="$ENV_FILE"
  [[ -f "$template" ]] || template="$ROOT_DIR/.server.env.example"
  tmp="$(mktemp "$ROOT_DIR/.server.env.tmp.XXXXXX")"
  chmod 600 "$tmp"
  awk -v key="$key" '
    BEGIN { replaced = 0 }
    /^OPENAI_API_KEY=/ {
      if (!replaced) print "OPENAI_API_KEY=" key
      replaced = 1
      next
    }
    { print }
    END { if (!replaced) print "OPENAI_API_KEY=" key }
  ' "$template" > "$tmp"
  mv "$tmp" "$ENV_FILE"
  chmod 600 "$ENV_FILE"
  unset key
  stop_ai_bridge
  # Export the just-written values without printing them.
  set -a
  source "$ENV_FILE"
  set +a
  start_ai_bridge
  say "OpenAI key saved to .server.env (mode 600); verify with './serverctl ai-status'"
  if is_running; then
    say "Restart Minecraft once to register /ai if this is the first setup"
  fi
}

cmd_logs() {
  [[ -f "$CONSOLE_LOG" ]] || die "no console log yet"
  tail -n "${LOG_LINES:-100}" -F "$CONSOLE_LOG"
}

cmd_backup() {
  mkdir -p "$BACKUP_DIR"
  local stamp archive
  stamp="$(date -u +%Y%m%d-%H%M%S)"
  archive="$BACKUP_DIR/astropolis-$stamp.tar.gz"
  if is_running; then
    send_command "save-all flush"
    sleep 5
  fi
  local paths=()
  for path in world server.properties whitelist.json ops.json banned-ips.json banned-players.json; do
    [[ -e "$SERVER_DIR/$path" ]] && paths+=("$path")
  done
  ((${#paths[@]})) || die "nothing to back up yet"
  tar -C "$SERVER_DIR" -czf "$archive" "${paths[@]}"
  say "backup created: $archive"
}

usage() {
  cat <<'EOF'
Usage: ./serverctl <command> [arguments]

  install             download mods, install Forge, deploy the RU pack
  start               start the server in the background
  stop                save and stop the server cleanly
  restart             stop, then start
  status              show process status
  ai-status           show AI bridge health and configuration state
  ai-deploy           deploy /ai files and start its loopback bridge
  ai-configure        securely read and save the OpenAI API key
  logs                follow the console log (Ctrl+C only exits the viewer)
  console <command>   send a Minecraft console command
  backup              flush saves and create a timestamped backup
EOF
}

command="${1:-}"
shift || true
case "$command" in
  install|deploy) cmd_install ;;
  start) cmd_start ;;
  stop) cmd_stop ;;
  restart) cmd_stop; cmd_start ;;
  status) cmd_status ;;
  ai-status) cmd_ai_status ;;
  ai-deploy) cmd_ai_deploy ;;
  ai-configure) cmd_ai_configure ;;
  logs) cmd_logs ;;
  console) send_command "$@" ;;
  backup) cmd_backup ;;
  *) usage; [[ -z "$command" ]] || exit 2 ;;
esac

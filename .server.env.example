# Copy this file to .server.env to override serverctl defaults.
MIN_RAM=4G
MAX_RAM=10G
STOP_TIMEOUT=120
# ASTROPOLIS_SERVER_DIR=/absolute/path/to/server
# JAVA_BIN=/absolute/path/to/java
# BACKUP_DIR=/absolute/path/to/backups

# Pack-aware /ai command. Keep the real key only in .server.env and chmod 600 it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
AI_ALLOWED_PLAYERS=shonadoto
AI_COOLDOWN_SECONDS=8
AI_BRIDGE_PORT=8765
